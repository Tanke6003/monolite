# Committed copy of the environment. Copy it to `.env`, which is git-ignored,
# and put the real values there. Every secret below is a placeholder on purpose:
# the moment a working password lives in a tracked file, it is public.

# ------------------------------------------------------------------- server --
PORT=3000
NODE_ENV=development
SERVICE_NAME=__serviceName__

# Where the API is mounted. It moves the whole surface —useful behind a proxy
# that serves this service under a path— but it does not create a new version:
# the contract is the code, so a real v2 is a second router.
API_PREFIX=__apiPrefix__

# --------------------------------------------------------------- hardening --
# Allowed CORS origins, comma separated. Empty means same-origin only; "*" is an
# explicit wildcard, and it is for development.
CORS_ORIGINS=http://localhost:3000

# Maximum JSON / urlencoded body size.
BODY_LIMIT=1mb

# Trusted proxy hops in front of the app (0 = none, 1 = one nginx or load
# balancer). Never "true": anything rate-limiting by IP would then count an
# address the client chose for itself.
TRUST_PROXY_HOPS=0

# OpenAPI document. Empty means enabled everywhere except production.
DOCS_ENABLED=

# ---------------------------------------------------------------- shutdown --
# Gap between reporting "not ready" and closing the socket, so the load balancer
# stops routing here before the port disappears. This is what removes the 502s
# from a rolling deploy; behind Kubernetes, 5000 is a sensible starting point.
SHUTDOWN_DELAY_MS=0
# Budget for the whole shutdown. Keep it under the orchestrator's grace period.
SHUTDOWN_TIMEOUT_MS=10000

# --------------------------------------------------------------- logging ----
# trace | debug | info | warn | error
LOG_LEVEL=debug

# -------------------------------------------------------------- persistence --
# Resolved by @monolite/data into the driver it builds.
DATA_SOURCE=__dataSource__
#if memory
# The in-memory driver keeps everything in the process: no container, no
# credentials, and the data is gone when the process is. Switching to a real
# engine later is this one variable plus the connection block it needs.
#endif
#if oracle
ORACLE_USER=__dbUser__
# Placeholder. The real one goes in `.env`, never here.
ORACLE_PASSWORD=change_me
# Easy Connect descriptor: host:port/service.
ORACLE_CONNECT_STRING=__oracleConnectString__
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
# Used only by docker-compose, to bootstrap the container's SYS account.
ORACLE_SYS_PASSWORD=change_me
ORACLE_PORT=__dbPort__
#endif
#if mssql
DB_HOST=__dbHost__
DB_PORT=__dbPort__
DB_USER=__dbUser__
# Placeholder. The real one goes in `.env`, never here. The container also reads
# it as the SA password, so it has to satisfy SQL Server's complexity rules.
DB_PASSWORD=change_me
DB_NAME=__dbName__
#endif
#if postgres
POSTGRES_HOST=__dbHost__
POSTGRES_PORT=__dbPort__
POSTGRES_USER=__dbUser__
# Placeholder. The real one goes in `.env`, never here.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=__dbName__
#endif
#if mysql
MYSQL_HOST=__dbHost__
MYSQL_PORT=__dbPort__
MYSQL_USER=__dbUser__
# Placeholder. The real one goes in `.env`, never here.
MYSQL_PASSWORD=change_me
MYSQL_DB=__dbName__
# Only docker-compose uses this one; the application never connects as root.
MYSQL_ROOT_PASSWORD=change_me
#endif
#if mongodb
MONGO_HOST=__dbHost__
MONGO_PORT=__dbPort__
MONGO_DB=__dbName__
# The development container runs without authentication, so leaving these empty
# is the normal local setup: the connector then omits credentials entirely.
MONGO_USER=
MONGO_PASSWORD=
#endif

#if auth
# -------------------------------------------------------------------- auth --
# Placeholder. Generate a real one —`openssl rand -hex 32`— and put it in `.env`.
# The application refuses to start with this value outside development.
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=3600
#endif
