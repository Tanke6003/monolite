{
  "name": "monolite",
  "version": "0.1.3",
  "private": true,
  "description": "A TypeScript backend toolkit you can adopt one package at a time.",
  "license": "MIT",
  "author": "Tanke6003",
  "homepage": "https://github.com/Tanke6003/monolite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanke6003/monolite.git"
  },
  "bugs": {
    "url": "https://github.com/Tanke6003/monolite/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "lint": "eslint \"packages/*/{src,tests}/**/*.ts\"",
    "test": "jest",
    "test:scripts": "cd scripts && node --test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:scripts",
    "release": "node scripts/release/run.mjs",
    "release:dry": "node scripts/release/run.mjs --dry-run",
    "cli": "node packages/cli/dist/bin/monolite.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.0",
    "eslint": "^9.36.0",
    "globals": "^17.11.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
